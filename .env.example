# Copier en `.env` :  cp .env.example .env
# `.env` est ignoré par git (règle éliminatoire : aucun secret dans le ZIP).
# Les valeurs ci-dessous sont des DÉFAUTS DE DÉMONSTRATION, pas des secrets.

# --- Base de données -------------------------------------------------------
# Utilisé par db-postgres ET par DATABASE_URL de payment-api (même valeur).
POSTGRES_PASSWORD=shadow_local_dev

# --- Machine de démonstration ---------------------------------------------
# Le pont hardware tourne sur l'hôte, pas dans Docker. Laisser vide = dry-run.
HARDWARE_PORT=

# --- Seuils de recette -----------------------------------------------------
# Durée d'affichage de UNDER_ATTACK avant REMEDIATING (mise en scène du clip).
ATTACK_HOLD_SECONDS=3
# Délai anti-rebond du détecteur après un déclenchement.
COOLDOWN_SECONDS=20
# Fenêtres consécutives anormales exigées avant de déclencher.
ANOMALY_STREAK_REQUIRED=3

# --- Déception active (WAF) -----------------------------------------------
# Âge médian des leurres (jours) au-delà duquel une transaction est jugée
# suspecte au bord et déroutée vers le honeypot. 8 j : au-dessus du maximum
# observé en trafic normal (5,84 j), sous le minimum observé en attaque (8,71 j).
DECOY_AGE_THRESHOLD=8.0

# --- Observabilité --------------------------------------------------------
# Mot de passe admin Grafana. Appliqué au PREMIER démarrage uniquement : si le
# volume `grafana-data` existe déjà, c'est l'ancien mot de passe qui reste
# (admin/admin par défaut). Pour le réinitialiser : docker compose down -v
GRAFANA_PASSWORD=admin

# --- Vault (optionnel) -----------------------------------------------------
# Sans VAULT_TOKEN, auth-service utilise JWT_SIGNING_KEY_CACHE et le DIT dans
# /healthz (`jwt_key_source: fallback_env`). Voir services/auth-service/main.py.
VAULT_TOKEN=
JWT_SIGNING_KEY_CACHE=dev-only-placeholder-rotate-me

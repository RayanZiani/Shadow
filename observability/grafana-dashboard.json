        { "expr": "shadow_probe_ok", "legendFormat": "sonde tx", "refId": "A" }
      ],
      "title": "Transaction de preuve",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "orange", "index": 0, "text": "INACTIVE" } }, "type": "value" },
            { "options": { "1": { "color": "purple", "index": 1, "text": "ARMÉE" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "shadow_waf_deception_active", "legendFormat": "déception", "refId": "A" }
      ],
      "title": "Déception active",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "shadow_last_score", "legendFormat": "score", "refId": "A" },
        { "expr": "shadow_threshold", "legendFormat": "seuil appris", "refId": "B" }
      ],
      "title": "Score ML vs seuil appris",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(shadow_waf_forwarded_total[1m])", "legendFormat": "trafic légitime", "refId": "A" },
        { "expr": "rate(shadow_waf_intercepted_total[1m])", "legendFormat": "attaquant dérouté", "refId": "B" }
      ],
      "title": "Déception : légitime vs dérouté",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "shadow_outputs_unspent", "legendFormat": "outputs dépensables", "refId": "A" },
        { "expr": "shadow_outputs_total", "legendFormat": "outputs totaux", "refId": "B" }
      ],
      "title": "Registre des outputs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "shadow_last_remediation_seconds", "legendFormat": "durée playbook", "refId": "A" }
      ],
      "title": "Durée de la remédiation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "shadow_ring_size", "legendFormat": "taille d'anneau", "refId": "A" },
        { "expr": "shadow_pin_failures_ratio", "legendFormat": "PIN refusés", "refId": "B" }
      ],
      "title": "Durcissement et surface PIN",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "id": 10,
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "up{job=~\"ml-detector|remediation-engine|payment-api|monero-crypto-core|waf|shadow-api|auth-service\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Disponibilité des services",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Connexions ouvertes sur la base `shadow_settle` (pg_stat_database_numbackends). Le seuil orange reprend l'alerte `PoolPostgresSature` (80) ; le rouge approche `max_connections` (100 par défaut).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(pg_stat_database_numbackends{datname=\"shadow_settle\"})", "legendFormat": "connexions", "refId": "A" }
      ],
      "title": "Connexions actives (PostgreSQL)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Taille sur disque de la base `shadow_settle` (pg_database_size_bytes), commandes et registre d'outputs compris. Seuils alignés sur l'alerte `BasePostgresVolumineuse` (2 Go).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2000000000 },
              { "color": "red", "value": 5000000000 }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"shadow_settle\"}", "legendFormat": "taille base", "refId": "A" }
      ],
      "title": "Taille de la base (PostgreSQL)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Âge de la transaction la plus ancienne encore ouverte (pg_stat_activity_max_tx_duration). ATTENTION : `pg_stat_statements` n'est PAS activé sur cette pile, donc ce panneau ne mesure PAS les « requêtes lentes » — il montre seulement une transaction qui traîne et retient ses verrous. Une valeur qui monte signale un blocage (verrou, requête applicative oubliée), pas une requête coûteuse.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "id": 13,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "max(pg_stat_activity_max_tx_duration)", "legendFormat": "transaction la plus longue", "refId": "A" }
      ],
      "title": "Transactions longues (PostgreSQL)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["resilience-alpha", "shadow-settle"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "RESILIENCE-ALPHA — état du service",
  "uid": "resilience-alpha",
  "version": 1

# --- Secrets : règle éliminatoire du workshop, ne jamais committer ---
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.joblib
*.pt

# --- Artefacts ML ---
# Le modèle est figé dans l'image Docker (voir services/ml-detector/Dockerfile).
# Les binaires ne sont pas versionnés ; threshold.json si, car il documente le
# seuil appris et les métriques d'évaluation citées dans le dossier technique.
services/ml-detector/scaler.joblib
services/ml-detector/isolation_forest.joblib
services/ml-detector/autoencoder.pt
# Baseline capturée localement : reproductible, mais propre à chaque poste.
services/ml-detector/baseline.jsonl
services/ml-detector/threshold_runtime.json

# --- Node / dashboard ---
node_modules/
dist/
.vite/

# --- Rust ---
services/monero-crypto-core/target/

# --- Modèles et artefacts 3D ---
*.stl
*.gcode
*.3mf

# --- Back-office : données locales et secrets de la carte ---
# La base SQLite vit dans le volume Docker `bo-data` ; en local, dans data/.
services/backoffice/data/
services/backoffice/*.db
services/backoffice/*.db-wal
services/backoffice/*.db-shm

# Boutique : PostgreSQL en pile complète, SQLite pour les tests et le poste
# local. Aucune base ne doit entrer dans le dépôt (données clients + état).
services/shop-api/data/
services/shop-api/*.db
services/shop-api/*.db-wal
services/shop-api/*.db-shm
# Les modèles faciaux (38 Mo) sont téléchargés et vérifiés à la construction de
# l'image : voir services/backoffice/Dockerfile.
services/backoffice/models/*.onnx
# secrets.h contient le mot de passe WiFi du point d'accès RESILIENCE-G<n>.
hardware/led_bandeau_esp8266/src/secrets.h
hardware/led_bandeau_esp8266/.pio/

